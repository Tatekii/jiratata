{
	"name": "jiratata-client",
	"version": "1.1.0",
	"private": true,
	"scripts": {
		"dev": "NODE_ENV=development next dev --turbopack",
		"build": "NODE_ENV=production next build",
		"build:dev": "NODE_ENV=development next build",
		"build:test": "NODE_ENV=test next build",
		"start": "NODE_ENV=production next start",
		"lint": "next lint",
		"test": "NODE_ENV=test vitest",
		"test:run": "NODE_ENV=test vitest run",
		"test:watch": "NODE_ENV=test vitest --watch",
		"test:coverage": "NODE_ENV=test vitest run --coverage",
		"test:server": "NODE_ENV=test vitest --config vitest.config.server.ts",
		"test:server:run": "NODE_ENV=test vitest run --config vitest.config.server.ts",
		"test:server:coverage": "NODE_ENV=test vitest run --coverage --config vitest.config.server.ts",
		"test:client": "NODE_ENV=test vitest --config vitest.config.client.ts",
		"test:client:run": "NODE_ENV=test vitest run --config vitest.config.client.ts",
		"test:client:coverage": "NODE_ENV=test vitest run --coverage --config vitest.config.client.ts",
		"test:components": "NODE_ENV=test vitest --config vitest.config.components.ts",
		"test:components:run": "NODE_ENV=test vitest run --config vitest.config.components.ts",
		"test:components:coverage": "NODE_ENV=test vitest run --coverage --config vitest.config.components.ts",
		"test:e2e": "NODE_ENV=test playwright test",
		"test:e2e:headed": "NODE_ENV=test playwright test --headed",
		"test:e2e:ui": "NODE_ENV=test playwright test --ui",
		"test:e2e:debug": "NODE_ENV=test playwright test --debug",
		"test:e2e:report": "NODE_ENV=test playwright show-report",
		"test:all": "npm run test:server:run && npm run test:client:run && npm run test:components:run",
		"release": "standard-version",
		"release:minor": "standard-version --release-as minor",
		"release:patch": "standard-version --release-as patch",
		"release:major": "standard-version --release-as major",
		"commit": "cz",
		"prepare": "husky install"
	},
	"dependencies": {
		"@formatjs/intl-localematcher": "^0.5.9",
		"@hello-pangea/dnd": "^17.0.0",
		"@hono/zod-validator": "^0.4.1",
